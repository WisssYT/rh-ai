# Talent Detective - local demo configuration. Copy to .env and adjust. NEVER commit real secrets.
APP_ENV=development
DEMO_MODE=true
PRODUCT_NAME=Talent Detective
COMPANY_NAME=Nordlicht Robotics (fictional)
# Docker Compose maps PostgreSQL to 55432 on localhost
DATABASE_URL=postgresql+psycopg://talent:talent-local-only@localhost:55432/talent
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=<generated local secret>
SESSION_TTL_HOURS=12
PUBLIC_APP_URL=http://localhost:5173
COMPANY_TIMEZONE=Africa/Tunis

# AI: live = real free-tier Gemini calls; replay = labelled synthetic deterministic output.
AI_MODE=replay
GEMINI_API_KEY=
# Verify the model is free-tier available for YOUR project in AI Studio before relying on it.
GEMINI_MODEL=gemini-2.5-flash
AI_CONCURRENCY=1
AI_RPM=5
AI_DAILY_CALL_BUDGET=40
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_RETRIES=2
AI_QUOTA_RETRIES=2

# Local inbox only (Mailpit). External delivery is blocked unless explicitly enabled.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=talent-detective@nordlicht.example.test
ALLOW_EXTERNAL_EMAIL=false
MAILPIT_UI_URL=http://localhost:8025

UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=10
HOLD_MINUTES=120
INVITATION_VALID_DAYS=7

SUPERVISOR_EMAIL=supervisor@nordlicht.example.test
SUPERVISOR_PASSWORD=
